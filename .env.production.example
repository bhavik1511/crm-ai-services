# ════════════════════════════════════════════════════════
# Grant Thornton CRM — Live Production Environment (.env)
# ════════════════════════════════════════════════════════

# ── Application Environment ──
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── CORS Settings (Crucial for AWS Amplify) ──
# Add your AWS Amplify domain URL and custom domain (comma-separated, NO trailing slash)
ALLOWED_ORIGINS=https://main.d123456.amplifyapp.com,https://crm.yourcompany.com,http://localhost:3000

# ── Independent CRM Backend API Base URL ──
# URL of your independent main backend service (used for task assignment, email read, entity resolution)
# Example: http://<backend-private-ip>:3001/api/v1 or https://backend.yourdomain.com/api/v1
CRM_API_BASE=http://localhost:3001/api/v1

# ── AWS RDS MySQL Connection ──

# Replace DB_HOST with your RDS MySQL endpoint (e.g. xxx.yyyyzzzz.us-east-1.rds.amazonaws.com)
DB_HOST=your-rds-endpoint.xxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=crm_api
DB_USER=crm_production_user
DB_PWD=your_strong_rds_password

# ── OpenAI / LLM Keys ──
OPENAI_API_KEY=sk-proj-your-live-openai-key

# ── JWT Authentication Secret ──
# Secret used to decode tokens sent from Amplify frontend
JWT_SECRET_KEY=your_64_char_hex_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ── MongoDB Setup (For AI Chat History & Vector Cache) ──
# Option 1 (Cloud Atlas): mongodb+srv://user:password@cluster0.mongodb.net/crm_ai?retryWrites=true&w=majority
# Option 2 (Local EC2 Container): mongodb://mongo:27017/crm_ai
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/crm_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=crm_ai


# ── Redis (Upstash / ElastiCache) ──
REDIS_URL=rediss://default:token@your-redis-host.upstash.io:6379
