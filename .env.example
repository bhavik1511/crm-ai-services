# ════════════════════════════════════════════════════════
# Grant Thornton CRM — AI Service Environment Variables
# ════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The app works in BOTH dev and prod — just change the values.

# ──────────────────────────────────────────────────────
# OpenAI
# ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ──────────────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────────────
# Generate secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=<64-char-hex-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ──────────────────────────────────────────────────────
# MySQL (existing CRM database — READ ONLY)
# ──────────────────────────────────────────────────────
DB_HOST=localhost                # prod: internal server IP
DB_PORT=3306
DB_NAME=crm_api
DB_USER=crm_readonly             # SELECT-only user recommended
DB_PWD=your_mysql_password_here

# ──────────────────────────────────────────────────────
# MongoDB Atlas (AI layer only)
# ──────────────────────────────────────────────────────
# Dev:  mongodb://localhost:27017/crm_ai
# Prod: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/crm_ai
MONGODB_URI=mongodb://localhost:27017/crm_ai
MONGODB_DB_NAME=crm_ai

# ──────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────
# Dev:  redis://localhost:6379
# Prod: rediss://default:token@abc.upstash.io:6379  (TLS)
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────
ENVIRONMENT=development          # change to: production on live server
CACHE_THRESHOLD=0.92             # vector similarity threshold (0.0–1.0)
ALLOWED_ORIGINS=http://localhost:3000   # prod: https://crm.yourcompany.com
LOG_LEVEL=DEBUG                  # prod: INFO

# ──────────────────────────────────────────────────────
# MCP Server (optional — if running MCP gateway)
# ──────────────────────────────────────────────────────
MCP_PORT=8001



